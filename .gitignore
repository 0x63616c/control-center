# Dependencies
node_modules/

# Build output
dist/
dist-portal/
build/

# Postgres migration artifacts (Swarm->CNPG dump + count tsvs, www-j934.8).
# The dump is the rollback copy held OFF any pgdata volume; never committed.
.pg-migration/

# Environment
.env
.env.*
!.env.example

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Tilt
.tilt/

# Local Temporal dev-server persistence
.temporal/

# Vite
.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Claude Code
.claude/settings.local.json

# OpenCode local quota state
opencode-quota/*
!opencode-quota/quota-toast.json

# Test coverage
coverage/
.vitest-reports/

# TypeScript build cache
*.tsbuildinfo

# Tesla map basemap tiles , large, host locally / on homelab (see www-gma)
apps/web/public/maps/*.pmtiles

# Storybook
*storybook.log
storybook-static

# ship workflow scratch + build worktrees
.claude/worktrees/
.claire/

# Runtime scheduler lock , ephemeral, never commit
.claude/scheduled_tasks.lock

# PR/verification screenshots , kept on local disk for reference, never tracked
# (referenced nowhere in docs/code; purged from history in www-st5j to keep the
# public repo lean). Drop new verification shots here freely; git ignores them.
docs/screenshots/

# Worktrees
.worktrees/

# Brainstorm mockups (visual companion sessions)
.superpowers/

# ESPHome per-config WiFi creds — beside the config, never committed (main
# WiFi pw lives in 1Password, not SOPS). See infra/esphome/README.md.
infra/esphome/secrets.yaml

# Talos/kube clusterconfig — ephemeral, rebuilt each session. Holds cluster CA +
# admin client cert/key + talos secrets. talhelper's generated inner .gitignore
# only shields talosconfig + the machine config, NOT the kubeconfigs, so ignore
# the whole dir here to stop an accidental `git add` leaking cluster-admin creds.
infra/talos/clusterconfig/

# Local prod DB dumps taken during the #111 postgres migration. Multi-MB
# snapshots of real data — never commit them.
.pg-snapshots/
