{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Backends currently connected to each instance, against the instance's max_connections setting. The dashed max_connections series is the ceiling, not a series to alert on.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "sum by (pod) (cnpg_backends_total{cluster_name=\"$cluster_name\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (pod) (cnpg_pg_settings_setting{cluster_name=\"$cluster_name\", name=\"max_connections\"})",
          "legendFormat": "{{pod}} max_connections",
          "refId": "B"
        }
      ],
      "title": "Connections vs max_connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Backends broken down by pg_stat_activity state. A growing 'idle in transaction' population is the usual cause of connection exhaustion.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "sum by (state) (cnpg_backends_total{cluster_name=\"$cluster_name\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Connections by state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "pg_database_size() per database, reported by the primary.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (datname) (cnpg_pg_database_size_bytes{cluster_name=\"$cluster_name\"})",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "title": "Database size",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Committed and rolled-back transactions per second, from pg_stat_database.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit{cluster_name=\"$cluster_name\"}[5m]))",
          "legendFormat": "{{datname}} commit",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_rollback{cluster_name=\"$cluster_name\"}[5m]))",
          "legendFormat": "{{datname}} rollback",
          "refId": "B"
        }
      ],
      "title": "Transaction rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Per-instance replication role and health. in_recovery = 1 means the pod is a standby; streaming_replicas is only meaningful on the primary.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (pod) (cnpg_pg_replication_in_recovery{cluster_name=\"$cluster_name\"})",
          "instant": true,
          "legendFormat": "{{pod}} in recovery",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (pod) (cnpg_pg_replication_streaming_replicas{cluster_name=\"$cluster_name\"})",
          "instant": true,
          "legendFormat": "{{pod}} streaming replicas",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (pod) (cnpg_collector_up{cluster_name=\"$cluster_name\"})",
          "instant": true,
          "legendFormat": "{{pod}} postgres up",
          "refId": "C"
        }
      ],
      "title": "Replication state",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Seconds a standby is behind the primary's last replayed transaction. Flat zero on the primary itself.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (pod) (cnpg_pg_replication_lag{cluster_name=\"$cluster_name\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Replication lag",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "How much of each instance's PGDATA (and WAL, when it is a separate volume) is in use against the PVC's provisioned size. The dashed capacity series is the hard ceiling: local-lvm enforces it, so hitting it means ENOSPC in Postgres, not a silent grow. Sourced from kubelet volume stats, so it is filesystem usage, not pg_database_size().",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{persistentvolumeclaim=~\"$cluster_name-[0-9]+(-wal)?\"})",
          "legendFormat": "{{persistentvolumeclaim}} used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=~\"$cluster_name-[0-9]+(-wal)?\"})",
          "legendFormat": "{{persistentvolumeclaim}} capacity",
          "refId": "B"
        }
      ],
      "title": "Volume usage vs capacity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "www-prometheus"
      },
      "description": "Percentage of each PVC's provisioned size in use. Amber at 75%, red at 90% - there is no expansion headroom on local-lvm without editing the PVC and restarting the instance.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "www-prometheus"
          },
          "expr": "100 * max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{persistentvolumeclaim=~\"$cluster_name-[0-9]+(-wal)?\"}) / max by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=~\"$cluster_name-[0-9]+(-wal)?\"})",
          "instant": true,
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A"
        }
      ],
      "title": "Volume used %",
      "type": "bargauge"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["cnpg", "postgres"],
  "templating": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "www-prometheus"
        },
        "definition": "label_values(cnpg_collector_up, cluster_name)",
        "hide": 0,
        "includeAll": false,
        "label": "Cluster",
        "multi": false,
        "name": "cluster_name",
        "options": [],
        "query": "label_values(cnpg_collector_up, cluster_name)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "CloudNativePG / PostgreSQL",
  "uid": "www-cnpg-postgres"
}
