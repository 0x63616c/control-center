{
  "name": "@www/infra-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "program.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker:check": "bun run --cwd workers/dont-text-your-ex-edge check",
    "worker:deploy": "bun run --cwd workers/dont-text-your-ex-edge deploy",
    "worker:upload:pass-through": "bun run --cwd workers/dont-text-your-ex-edge upload:pass-through",
    "worker:deploy:pass-through": "bun run --cwd workers/dont-text-your-ex-edge deploy:pass-through"
  },
  "dependencies": {
    "@www/platform": "workspace:*",
    "@pulumi/pulumi": "^3.145.0",
    "@pulumi/cloudflare": "^5.49.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
