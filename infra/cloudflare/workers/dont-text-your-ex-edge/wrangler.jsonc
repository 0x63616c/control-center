{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "dont-text-your-ex-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "GENERAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "REPORT_EVIDENCE_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
