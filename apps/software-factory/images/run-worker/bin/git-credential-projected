#!/bin/sh
set -eu

credential_dir="${RUN_WORKER_GITHUB_CREDENTIAL_DIR:-/var/run/secrets/software-factory/github}"

# Git invokes helpers for get/store/erase. The projected Secret is the sole
# writer, so only get has work to do; consuming stdin keeps the protocol clean.
while IFS= read -r line && [ -n "$line" ]; do :; done
[ "${1:-}" = get ] || exit 0

login="$(cat "$credential_dir/login")"
token="$(cat "$credential_dir/token")"
[ -n "$login" ]
[ -n "$token" ]
printf 'username=%s\npassword=%s\n\n' "$login" "$token"
