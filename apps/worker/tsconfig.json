{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    // Mirrors api: the worker runs via `bun src/index.ts` and never emits.
    // allowImportingTsExtensions lets it resolve @control-center/api's .ts barrel.
    "allowImportingTsExtensions": true,
    // The worker imports generated App facet aggregates for queue jobs and
    // interval cycles. Those aggregates pull @features/* and @app-kit into the
    // worker's TypeScript program, so their aliases must be restated here.
    "paths": {
      "@app-kit": ["../../app-kit/index.ts"],
      "@app-kit/server": ["../../app-kit/server.ts"],
      "@features/*": ["../../features/*"]
    }
  },
  "include": ["src"]
}
