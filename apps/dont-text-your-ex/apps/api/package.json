{
  "name": "@dont-text-your-ex/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "seed": "APP_ENV=development bun run src/seed.ts",
    "moderation:admin": "bun run src/moderation-admin.ts",
