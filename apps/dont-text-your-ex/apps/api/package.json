    "seed:reset": "APP_ENV=development TYE_RESET=1 bun run src/seed.ts"
  },
  "dependencies": {
    "@dont-text-your-ex/notifications": "workspace:*",
    "@temporalio/client": "^1.21.1",
    "hono": "^4.6.14",
    "jose": "^6.2.3",
    "@www/logger": "workspace:*",
    "@www/platform": "workspace:*",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "@types/pg": "^8.11.10",
    "vitest": "^3.2.4"
  }
}
