# syntax=docker/dockerfile:1
FROM oven/bun:1.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/
COPY apps/manage/package.json apps/manage/
COPY apps/map-provision/package.json apps/map-provision/
COPY apps/storybook/package.json apps/storybook/
COPY apps/temporal-worker/package.json apps/temporal-worker/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY apps/dont-text-your-ex/package.json apps/dont-text-your-ex/
COPY apps/dont-text-your-ex/apps/api/package.json apps/dont-text-your-ex/apps/api/
COPY apps/dont-text-your-ex/apps/e2e/package.json apps/dont-text-your-ex/apps/e2e/
COPY apps/dont-text-your-ex/apps/frontend/package.json apps/dont-text-your-ex/apps/frontend/
COPY apps/dont-text-your-ex/apps/temporal-worker/package.json apps/dont-text-your-ex/apps/temporal-worker/
COPY apps/dont-text-your-ex/packages/notifications/package.json apps/dont-text-your-ex/packages/notifications/
COPY packages/api/package.json packages/api/
COPY packages/core/package.json packages/core/
COPY packages/logger/package.json packages/logger/
COPY packages/platform/package.json packages/platform/
COPY packages/temporal-runtime/package.json packages/temporal-runtime/
COPY packages/theme/package.json packages/theme/
COPY packages/worker-runtime/package.json packages/worker-runtime/
COPY infra/package.json infra/
COPY infra/cloudflare/package.json infra/cloudflare/
COPY infra/cloudflare/workers/dont-text-your-ex-edge/package.json infra/cloudflare/workers/dont-text-your-ex-edge/
COPY infra/unifi/package.json infra/unifi/
RUN bun install --frozen-lockfile --production --ignore-scripts
COPY apps/dont-text-your-ex/apps/temporal-worker apps/dont-text-your-ex/apps/temporal-worker
COPY apps/dont-text-your-ex/apps/api/src apps/dont-text-your-ex/apps/api/src
COPY apps/dont-text-your-ex/contracts apps/dont-text-your-ex/contracts
COPY apps/dont-text-your-ex/packages/notifications apps/dont-text-your-ex/packages/notifications
COPY packages/logger packages/logger
COPY packages/platform packages/platform
COPY packages/temporal-runtime packages/temporal-runtime
RUN cd apps/dont-text-your-ex/apps/temporal-worker && bun build src/index.ts --target=node \
      --external '@temporalio/*' --outfile ../../../../dist/dtye-temporal-worker.mjs

FROM node:22-slim AS runtime
WORKDIR /app
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/apps/dont-text-your-ex/apps/temporal-worker/src apps/dont-text-your-ex/apps/temporal-worker/src
COPY --from=build /app/apps/dont-text-your-ex/apps/api/src/domain-events.ts apps/dont-text-your-ex/apps/api/src/domain-events.ts
COPY --from=build /app/apps/dont-text-your-ex/contracts apps/dont-text-your-ex/contracts
COPY --from=build /app/apps/dont-text-your-ex/packages/notifications apps/dont-text-your-ex/packages/notifications
COPY --from=build /app/dist/dtye-temporal-worker.mjs apps/dont-text-your-ex/apps/temporal-worker/src/index.mjs
CMD ["node", "apps/dont-text-your-ex/apps/temporal-worker/src/index.mjs"]
